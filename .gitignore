# ── Large data assets (fetched/generated at runtime) ──────────────────────────
# Zemax optical data — PSF images and XY tables.
# The repo ships compressed archives (*.tar.gz / VROOMM_V04_XY.txt.gz);
# simulate_detector.py auto-extracts them on first run. Ignore everything
# else in the directory (raw extracted files, legacy/redundant copies).
assets/zemax_data/*
!assets/zemax_data/images_fibre_rectangulaire.tar.gz
!assets/zemax_data/images_fibre_octogonale_2.tar.gz
!assets/zemax_data/VROOMM_V04_XY.txt.gz

# Spectral models — BT-Settl CIFIST grid, TAPAS npy cache, sky OH cache
assets/spectral_models/*.dat
assets/spectral_models/*.npy

# TAPAS FITS file (180 MB)
assets/*.fits
assets/**/*.fits

# ── Simulation outputs ────────────────────────────────────────────────────────
detector_sim.fits
detector_sim.npy
detector_sim.png
night_output/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
